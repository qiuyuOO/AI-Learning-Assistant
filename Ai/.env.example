# =============================================================================
# 复制本文件为 .env 后填入真实值：  cp .env.example .env
# .env 已被 .gitignore 忽略，切勿把真实密钥提交到仓库。
# 本文件只放占位符，可以安全入库，供协作者参照需要配置哪些变量。
# =============================================================================

# ---------- LLM 接入（必填）----------
# 走 DeepSeek 的 Anthropic 兼容层。变量名沿用 ANTHROPIC_* 是因为
# LLMClient/adapter 用这套名字读取，实际指向的是 DeepSeek。

# 模型名。不填时代码默认 deepseek-flash。
ANTHROPIC_MODEL_NAME=deepseek-flash

# API 密钥。必填，无默认值（不填则为空串，请求会 401）。
ANTHROPIC_API_KEY=sk-your-api-key-here

# 兼容层 Base URL。必填，代码无默认值。
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# ---------- MCP 工具（可选）----------
# 知乎开放平台 MCP 的 Access Secret，用于连接 https://developer.zhihu.com/api/mcp/v1
# 并注册其远程工具（热榜 / 搜索 / 直答等）。不填或填错时服务仍可启动，
# 但会自动降级为"仅本地工具"，知乎相关能力不可用。
ZHIHU_API_KEY=your-zhihu-access-secret-here

# ---------- 长期记忆（可选）----------
# 每积累多少次交互后台批量更新一次记忆。默认 10。
MEMORY_UPDATE_EVERY=10

# ---------- Web 后端 / 前端（可选，仅跑 server.py 时用到）----------
# 后端监听端口。默认 8000（Vite 代理 /api 指向它）。
WEB_PORT=8000

# 默认 operator_id（用户级长期记忆的聚合键）。默认 web。
WEB_OPERATOR_ID=web

# 允许跨域访问的前端来源，逗号分隔。默认已含本地 5173。
WEB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
